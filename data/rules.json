    "BOTTOM": [
      "Ardent Censer",
      "Dawncore",
      "Echoes of Helia",
      "Imperial Mandate",
      "Locket of the Iron Solari",
      "Mikael's Blessing",
      "Moonstone Renewer",
      "Redemption",
      "Shurelya's Battlesong",
