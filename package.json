{
  "name": "metamunch",
  "version": "0.1.0-alpha",
  "description": "Desktop League of Legends companion: item recommendations, personal match statistics and patch changes from public Data Dragon and Riot API data.",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "cross-env LIVE=1 vitest run tests/integration/ddragon-live.test.ts",
    "test:live:riot": "cross-env LIVE_RIOT=1 vitest run tests/integration/riot-live.test.ts",
    "test:live:patch": "cross-env LIVE=1 vitest run tests/integration/patch-live.test.ts",
    "inspect:items": "cross-env LIVE=1 vitest run tests/integration/items-inspect.test.ts",
    "spike:sqlite": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/sqlite-spike.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koelakanttt/MetaMunch.git"
  },
  "keywords": [],
  "author": "MetaMunch contributors",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Koelakanttt/MetaMunch/issues"
  },
  "homepage": "https://github.com/Koelakanttt/MetaMunch#readme",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
